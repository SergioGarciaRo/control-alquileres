generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER")
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(cuid())
  name       String?
  email      String     @unique
  password   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  properties Property[]
  sessions   Session[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Property {
  id             String     @id @default(cuid())
  userId         String
  name           String
  address        String
  type           String     @default("APARTMENT")
  rooms          Int?
  status         String     @default("AVAILABLE")
  expectedRent   Float      @default(0)
  fixedExpenses  Float      @default(0)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenants        Tenant[]
  payments       Payment[]
  expenses       Expense[]
  deposits       Deposit[]
  incidents      Incident[]
  documents      Document[]
}

model Tenant {
  id             String          @id @default(cuid())
  propertyId     String
  name           String
  phone          String?
  email          String?
  startDate      DateTime
  endDate        DateTime?
  rent           Float
  status         String          @default("ACTIVE")
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantPayments TenantPayment[]
  deposits       Deposit[]
  incidents      Incident[]
  documents      Document[]
}

model Payment {
  id             String          @id @default(cuid())
  propertyId     String
  month          Int
  year           Int
  expectedAmount Float
  paidAmount     Float           @default(0)
  dueDate        DateTime
  paidDate       DateTime?
  status         String          @default("PENDING")
  method         String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantPayments TenantPayment[]
}

model TenantPayment {
  id             String    @id @default(cuid())
  paymentId      String
  tenantId       String
  expectedAmount Float
  paidAmount     Float     @default(0)
  status         String    @default("PENDING")
  paidDate       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  payment        Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(cuid())
  propertyId  String
  date        DateTime
  amount      Float
  category    String
  description String?
  receiptUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Deposit {
  id              String    @id @default(cuid())
  propertyId      String
  tenantId        String
  amount          Float
  deliveryDate    DateTime
  status          String    @default("HELD")
  returnDate      DateTime?
  retainedAmount  Float?
  retentionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Incident {
  id           String     @id @default(cuid())
  propertyId   String
  tenantId     String?
  title        String
  description  String?
  category     String
  priority     String     @default("MEDIUM")
  status       String     @default("OPEN")
  cost         Float?
  openDate     DateTime   @default(now())
  resolvedDate DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant       Tenant?    @relation(fields: [tenantId], references: [id])
  documents    Document[]
}

model Document {
  id         String    @id @default(cuid())
  propertyId String?
  tenantId   String?
  incidentId String?
  name       String
  type       String
  url        String
  size       Int?
  mimeType   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
}

model Reminder {
  id         String    @id @default(cuid())
  propertyId String?
  tenantId   String?
  type       String
  title      String
  message    String?
  dueDate    DateTime
  sent       Boolean   @default(false)
  sentAt     DateTime?
  channel    String    @default("APP")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
